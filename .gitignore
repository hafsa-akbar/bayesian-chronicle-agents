# Experiment outputs: raw event logs, transcripts, and API caches are bulky and
# regenerable from the scripts. The per-run aggregates that the paper's figures
# and tables are built from are whitelisted below and stay in the repo.
experiments/outputs/**
!experiments/outputs/**/
!experiments/outputs/**/metrics.json
!experiments/outputs/**/belief_by_round.csv
!experiments/outputs/**/dose_response.csv
!experiments/outputs/**/sliders.csv
!experiments/outputs/**/alignment_by_bin.csv
!experiments/outputs/**/appraiser_calibration_metrics.json
!experiments/outputs/**/gamma_oracle_summary.csv
!experiments/outputs/**/gamma_oracle_committed_dose.csv
!experiments/outputs/**/exact_kappa_summary.csv
!experiments/outputs/**/exact_recovery.json
!experiments/outputs/**/provenance.json
!experiments/outputs/figures/*.png

